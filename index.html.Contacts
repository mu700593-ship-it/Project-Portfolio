<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact Me | Portfolio</title>
  <link rel="stylesheet" href="style.css" />
</head>
 <a href="index.html.HomePage"> Home </a> | <a href="index.html.Skills"> Skills</a> | <a href="index.html.Contacts"> Contacts</a> | <a href="index.html.Projects">Projects</a> | <a href="index.html.About"> About</a>
<body>
  <main class="contact-container">
    
    <section class="contact-info">
      <h1>Contact Me</h1>
      <p>Have a project or a question? Feel free to reach out.</p>
    
    </section>

    <section class="contact-form">
      <form id="contactForm" novalidate>
        
        <div class="form-group">
          <label for="name">Name</label>
          <input type="text" id="name" required />
          <small class="error"></small>
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" required />
          <small class="error"></small>
        </div>
		<div class="contact-box">
<h2>Contact Me</h2>
<p>Email:</p>
<a href="mailto:mu7005393@gmail.com">mu7005393@gmail.com</a>
</div>

        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" rows="5" required></textarea>
          <small class="error"></small>
        </div>

        <button type="submit">Send Message</button>
        <p class="success-message"></p>

      </form>
    </section>

  </main>

  <script src="script.js"></script>
</body>
</html>
